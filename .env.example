STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_SOLO="price_..."

# App
APP_URL="http://localhost:3000"
CLIENT_URL="http://localhost:3000/client"

# Scheduler
SCHEDULER_TICK_MINUTES=15
